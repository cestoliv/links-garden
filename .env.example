# Beeper Client API — create an access token in Beeper Desktop settings
BEEPER_ACCESS_TOKEN=
BEEPER_API_URL=http://127.0.0.1:23373
BEEPER_CHAT_ID=

# Ollama
OLLAMA_URL=http://127.0.0.1:11434
EMBEDDING_MODEL=bge-m3
EXTRACTION_MODEL=qwen3:8b

# Obsidian
VAULT_PATH=
VAULT_EXCLUDE=wiki,.obsidian

# Ingestion
BACKFILL_START_DATE=2026-08-25

# Fetching — firecrawl proxies every request to protect the home IP.
# Falls back to direct with a startup warning when the key is missing.
FETCH_BACKEND=firecrawl
FIRECRAWL_API_KEY=

# API — bearer token checked on every route
API_TOKEN=
DATABASE_PATH=data/garden.db
