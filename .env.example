# Running via docker-compose.yml? It overrides OLLAMA_URL, BEEPER_API_URL, DATABASE_PATH and
# FETCH_CACHE_DIR with container-internal values, so what you set for those here is ignored.
# Everything else, including API_TOKEN, still comes from this file.
#
# VAULT_PATH is the exception: set it here even under Docker. Compose reads it from this file to
# find the vault on the host, then mounts it read-only inside the container. Leave it empty and
# no vault is mounted, so `sync-vault` has nothing to index.

# Beeper Client API — create an access token in Beeper Desktop settings
BEEPER_ACCESS_TOKEN=
BEEPER_API_URL=http://127.0.0.1:23373
BEEPER_CHAT_ID=

# Ollama
OLLAMA_URL=http://127.0.0.1:11434
EMBEDDING_MODEL=bge-m3
EXTRACTION_MODEL=qwen3:8b

# Obsidian
VAULT_PATH=
VAULT_EXCLUDE=wiki,.obsidian

# Ingestion
BACKFILL_START_DATE=2026-08-25

# Fetching — firecrawl proxies every request to protect the home IP.
# Falls back to direct with a startup warning when the key is missing.
FETCH_BACKEND=firecrawl
FIRECRAWL_API_KEY=
FETCH_CACHE_DIR=.cache/fetch
MAX_FETCHES_PER_RUN=50

# API — bearer token checked on every /api route; the dashboard exchanges it for a session
# cookie instead of holding it itself. SESSION_MAX_AGE_DAYS is optional, default shown below.
API_TOKEN=
DATABASE_PATH=data/garden.db
SESSION_MAX_AGE_DAYS=30
