# Optional: override the API's address. Defaults to a relative path proxied to
# http://127.0.0.1:8791 by `npm run dev` (see vite.config.ts). Set this for a build
# that isn't served through that dev proxy.
# VITE_API_BASE_URL=http://127.0.0.1:8791

# The API token is never set here — the dashboard asks for it at sign-in and keeps it in memory.
